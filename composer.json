{
    "name": "foolz/theme",
    "type": "library",
    "description": "An opinionated theme system where even the views can be classes, and everything is a plugin.",
    "keywords": ["theme", "views", "template"],
    "homepage": "http://www.foolz.us",
    "license": "Apache-2.0",
    "authors": [{"name": "foolz", "email": "support@foolz.us"}],
    "support": {
        "email": "support@foolz.us",
        "irc": "irc://irc.irchighway.net/fooldriver"
    },
    "require": {
        "php": "^8.1",
        "foolz/package": "dev-master"
    },
    "config": {
        "platform": { "php": "8.1.0" }
    },
	"require-dev": {
		"foolz/cache": "dev-php83-support"
	},
    "autoload": {
        "psr-4": {
            "Foolz\\Theme\\": "src/"
        }
    }
}
